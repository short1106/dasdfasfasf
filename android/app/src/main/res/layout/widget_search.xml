<?xml version="1.0" encoding="utf-8"?>
<!-- Dulidan Suchleiste für den Startbildschirm -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/widget_bg"
    android:paddingStart="6dp"
    android:paddingEnd="7dp">

    <ImageView
        android:id="@+id/w_logo"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_fg"
        android:contentDescription="Dulidan" />

    <LinearLayout
        android:id="@+id/w_search"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="4dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Suche mit Dulidan"
            android:textColor="#EFEAF7"
            android:textSize="15sp"
            android:maxLines="1"
            android:fontFamily="sans-serif-medium" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DREAM · DESIGN · DEVELOP"
            android:textColor="#FF7AE6"
            android:textSize="8.5sp"
            android:letterSpacing="0.18"
            android:maxLines="1"
            android:fontFamily="monospace" />
    </LinearLayout>

    <ImageView
        android:id="@+id/w_calc"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="9dp"
        android:background="@drawable/widget_btn2"
        android:src="@drawable/ic_w_calc"
        android:contentDescription="Rechner" />

    <ImageView
        android:id="@+id/w_mic"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="7dp"
        android:padding="10dp"
        android:background="@drawable/widget_btn"
        android:src="@drawable/ic_w_mic"
        android:contentDescription="Sprachsuche" />
</LinearLayout>
